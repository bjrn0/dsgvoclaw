# MasterCrab Configuration
# Copy this file to .env and fill in your values

# NVIDIA API Key (for Nemotron 3 Super inference)
NVIDIA_API_KEY=

# Gateway authentication token (generate with: openssl rand -hex 32)
MASTERCRAB_GATEWAY_TOKEN=

# Optional: Ollama endpoint for local inference
# OLLAMA_HOST=http://localhost:11434

# Optional: Channel tokens (enable in openclaw.json first)
# WHATSAPP_SESSION_PATH=
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# DISCORD_BOT_TOKEN=
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=

# Admin panel port
ADMIN_PORT=18800
